# Environment — use .env or .env.local in the project root (never commit real keys)
# After changes: stop and restart `pnpm dev`

# Groq — real key from https://console.groq.com (must start with gsk_)
GROQ_API_KEY=gsk_your_real_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Supabase — copy the same values from Vita AI (.env.local)
# Enables persistent clinician data (see database/README.md)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key
# Optional: apply SQL migrations from CLI (pnpm run db:apply-ihealth-migrations)
# SUPABASE_DB_PASSWORD=your_db_password

# Vita AI patient portal (module 1.1). Patient role opens this URL.
# Default if unset: http://localhost:3001/dashboard (Vita dev server)
# Set to empty to disable and use the built-in demo at /patient/local only
NEXT_PUBLIC_VITA_PATIENT_URL=http://localhost:3001/dashboard
